[gd_resource type="Theme" load_steps=2 format=3]

[sub_resource type="SystemFont" id="SystemFont_kid"]
font_names = PackedStringArray("Segoe UI Rounded", "Comic Sans MS", "Arial Rounded MT Bold", "Microsoft YaHei", "Segoe UI", "Arial")
allow_system_fallback = true
subpixel_positioning = 1

[resource]
default_font = SubResource("SystemFont_kid")
default_font_size = 30
